{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/invite/:code", "destination": "/index.html" },
    { "source": "/invitation/:code", "destination": "/index.html" },
    { "source": "/parrain/:code", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
